{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/clip.schema.json",
  "title": "Clip annotation",
  "description": "Annotations of one rendered clip: where each hazard is on screen, frame by frame. Coordinates are normalized (0..1) to the full video frame, origin top-left.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "video", "views", "hazards"],
  "properties": {
    "schemaVersion": { "const": 0 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "$ref": "#/$defs/i18nText" },
    "kind": {
      "description": "exam: full clip usable in an exam series. short: ~10 s single-hazard exercise (D4).",
      "enum": ["exam", "short"],
      "default": "exam"
    },
    "generation": {
      "description": "How the clip was produced, so it can be rendered again identically (D1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "seed"],
      "properties": {
        "scenario": { "type": "string", "description": "Scenario template id (Godot scene or YAML file)" },
        "seed": { "type": "integer", "minimum": 0 },
        "generatorVersion": { "type": "string" }
      }
    },
    "conditions": {
      "description": "Rendering conditions (D5). See docs/hazard-catalog.md.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeOfDay": { "enum": ["day", "dawn", "dusk", "night"] },
        "weather": { "enum": ["clear", "overcast", "rain", "fog", "low_sun", "snow"] },
        "environment": { "enum": ["urban", "residential", "rural", "expressway", "roundabout", "roadworks"] }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "width", "height", "frameCount"],
      "properties": {
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frameCount": { "type": "integer", "minimum": 1 },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "type"],
            "properties": {
              "src": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        }
      }
    },
    "views": {
      "description": "Screen rectangles of each view (windshield and mirrors).",
      "type": "object",
      "additionalProperties": false,
      "required": ["windshield"],
      "properties": {
        "windshield": { "$ref": "#/$defs/rect" },
        "mirrorCenter": { "$ref": "#/$defs/rect" },
        "mirrorLeft": { "$ref": "#/$defs/rect" },
        "mirrorRight": { "$ref": "#/$defs/rect" }
      }
    },
    "hazards": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/hazard" }
    },
    "decoys": {
      "description": "Road users that draw the eye but are not hazards. A click on them is a lost click.",
      "type": "array",
      "items": { "$ref": "#/$defs/decoy" }
    },
    "predictions": {
      "description": "'Pause: what happens next?' questions (D4).",
      "type": "array",
      "items": { "$ref": "#/$defs/prediction" }
    }
  },
  "$defs": {
    "i18nText": {
      "type": "object",
      "required": ["fr"],
      "properties": {
        "fr": { "type": "string" },
        "nl": { "type": "string" },
        "de": { "type": "string" },
        "en": { "type": "string" }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "items": false,
      "minItems": 2
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "minimum": 0, "maximum": 1 },
        "h": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "keyframe": {
      "description": "Hazard outline at one frame. The player interpolates between keyframes. visible=false means hidden (occluded or off screen) from this frame on.",
      "type": "object",
      "additionalProperties": false,
      "required": ["frame"],
      "properties": {
        "frame": { "type": "integer", "minimum": 0 },
        "visible": { "type": "boolean", "default": true },
        "polygon": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" },
          "minItems": 3
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "keyframes"],
      "properties": {
        "view": { "enum": ["windshield", "mirrorCenter", "mirrorLeft", "mirrorRight"] },
        "keyframes": {
          "type": "array",
          "items": { "$ref": "#/$defs/keyframe" },
          "minItems": 1
        }
      }
    },
    "hazard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "window", "idealFrame", "tracks", "label", "explanation"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "description": "See docs/hazard-catalog.md" },
        "tags": {
          "description": "Extra categories for adaptive training (D2), e.g. mirror, vulnerable_user, priority.",
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "label": { "$ref": "#/$defs/i18nText" },
        "explanation": { "$ref": "#/$defs/i18nText" },
        "window": {
          "description": "Frames during which a click on the hazard counts.",
          "type": "object",
          "additionalProperties": false,
          "required": ["startFrame", "endFrame"],
          "properties": {
            "startFrame": { "type": "integer", "minimum": 0 },
            "endFrame": { "type": "integer", "minimum": 0 }
          }
        },
        "idealFrame": {
          "description": "Earliest moment a careful driver should notice the hazard. Used for the precision score (D3).",
          "type": "integer",
          "minimum": 0
        },
        "tracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/track" },
          "minItems": 1
        }
      }
    },
    "decoy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tracks", "explanation"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "description": "See docs/hazard-catalog.md (decoy_*)" },
        "explanation": { "$ref": "#/$defs/i18nText" },
        "tracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/track" },
          "minItems": 1
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pauseFrame", "question", "choices"],
      "properties": {
        "pauseFrame": { "type": "integer", "minimum": 0 },
        "hazardId": { "type": "string", "description": "Hazard this question is about, if any" },
        "question": { "$ref": "#/$defs/i18nText" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "correct"],
            "properties": {
              "text": { "$ref": "#/$defs/i18nText" },
              "correct": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
