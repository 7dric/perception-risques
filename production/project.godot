; Engine configuration file.
; Production tool: renders scenarios to video + annotation JSON (see docs/ARCHITECTURE.md).

config_version=5

[application]

config/name="Perception des risques — production"
config/description="Scénarios 3D rendus en vidéos et annotations JSON"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/vsync/vsync_mode=0
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"

[editor]

movie_writer/fps=30

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
scaling_3d/scale=2.0
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
global_illumination/sdfgi/probe_ray_count=4
global_illumination/sdfgi/frames_to_converge=5
environment/ssao/quality=3
environment/ssil/quality=3
environment/screen_space_reflection/roughness_quality=3
textures/default_filters/anisotropic_filtering_level=4
